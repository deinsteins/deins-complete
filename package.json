{
  "name": "deinscomplete",
  "displayName": "DeinsComplete",
  "description": "Fast AI-powered inline code completion for VS Code.",
  "version": "0.1.13",
  "publisher": "deinscomplete",
  "icon": "media/deinscomplete-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/deinsteins/deins-complete.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deinscomplete.enable",
        "title": "DeinsComplete: Enable"
      },
      {
        "command": "deinscomplete.disable",
        "title": "DeinsComplete: Disable"
      },
      {
        "command": "deinscomplete.showLogs",
        "title": "DeinsComplete: Show Logs"
      },
      {
        "command": "deinscomplete.diagnostics",
        "title": "DeinsComplete: Diagnostics"
      },
      {
        "command": "deinscomplete.checkBackend",
        "title": "DeinsComplete: Check Backend"
      },
      {
        "command": "deinscomplete.resetAuthentication",
        "title": "DeinsComplete: Reset Authentication"
      },
      {
        "command": "deinscomplete.signIn",
        "title": "DeinsComplete: Sign In"
      },
      {
        "command": "deinscomplete.signOut",
        "title": "DeinsComplete: Sign Out"
      },
      {
        "command": "deinscomplete.accountStatus",
        "title": "DeinsComplete: Account Status"
      },
      {
        "command": "deinscomplete.accountCenter",
        "title": "DeinsComplete: Open Account Center"
      },
      {
        "command": "deinscomplete.welcome",
        "title": "DeinsComplete: Welcome & Getting Started"
      },
      {
        "command": "deinscomplete.triggerCompletion",
        "title": "DeinsComplete: Trigger Inline Completion"
      },
      {
        "command": "deinscomplete.clearCompletionCache",
        "title": "DeinsComplete: Clear Completion Cache"
      },
      {
        "command": "deinscomplete.showCompletionStats",
        "title": "DeinsComplete: Show Completion Stats"
      },
      {
        "command": "deinscomplete.feedbackHelpful",
        "title": "DeinsComplete: Mark Last Suggestion Helpful"
      },
      {
        "command": "deinscomplete.feedbackNotHelpful",
        "title": "DeinsComplete: Mark Last Suggestion Not Helpful"
      },
      {
        "command": "deinscomplete.reportBadSuggestion",
        "title": "DeinsComplete: Report Bad Suggestion"
      },
      {
        "command": "deinscomplete.copyDiagnostics",
        "title": "DeinsComplete: Copy Privacy-Safe Diagnostics"
      }
    ],
    "configuration": {
      "title": "DeinsComplete",
      "properties": {
        "deinscomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DeinsComplete AI code completion."
        },
        "deinscomplete.context.maxPrefixCharacters": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "maximum": 20000,
          "description": "Maximum number of characters collected before the cursor for inline completion context."
        },
        "deinscomplete.context.maxSuffixCharacters": {
          "type": "number",
          "default": 2000,
          "minimum": 200,
          "maximum": 10000,
          "description": "Maximum number of characters collected after the cursor for inline completion context."
        },
        "deinscomplete.repositoryContext.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Include small, relevant workspace-file context with completion requests."
        },
        "deinscomplete.repositoryContext.maxFiles": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum number of related workspace files included in a completion request."
        },
        "deinscomplete.repositoryContext.maxCharacters": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "Maximum total characters from related workspace files included in a completion request."
        },
        "deinscomplete.repositoryContext.timeoutMs": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "maximum": 100,
          "description": "Time budget for collecting related workspace context."
        },
        "deinscomplete.backend.url": {
          "type": "string",
          "default": "https://api.deinscomplete.web.id",
          "description": "DeinsComplete backend service URL."
        },
        "deinscomplete.backend.timeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Maximum time to wait for a DeinsComplete backend completion request."
        },
        "deinscomplete.streaming.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use streaming completion when the managed backend supports it."
        },
        "deinscomplete.completion.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before requesting an inline completion."
        },
        "deinscomplete.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Cache recent inline completions in memory."
        },
        "deinscomplete.cache.ttlMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Completion cache lifetime in milliseconds."
        },
        "deinscomplete.cache.maxEntries": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum in-memory completion cache entries."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint src test --ext .ts",
    "test": "npm run compile && node scripts/run-tests.js",
    "package": "vsce package --allow-missing-repository",
    "package:vsix": "npm run package",
    "release:validate": "node scripts/validate-release.js",
    "evaluate:provider": "node scripts/evaluate-provider.js"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vscode/vsce": "^2.26.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
