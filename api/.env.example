APP_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
AUTH_ENABLED=false
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=0
AUTH_TOKEN_VERSION=1
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
USAGE_QUOTA_ENABLED=false
USAGE_QUOTA_DAILY_REQUESTS=2000

AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
AI_MAX_TOKENS=128
AI_CANDIDATE_COUNT=1
AI_TEMPERATURE=0.1
AI_MAX_COMPLETION_LINES=20
AI_MAX_COMPLETION_CHARS=8000
AI_COMPLETION_MODE=chat
AI_API_MODE=chat
AI_FIM_PREFIX_TOKEN=
AI_FIM_SUFFIX_TOKEN=
AI_FIM_MIDDLE_TOKEN=
AI_FIM_END_TOKEN=
AI_FIM_FILENAME_CONTEXT_ENABLED=false
STREAMING_ENABLED=false
REDIS_ENABLED=false
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000

# User accounts (enable PostgreSQL before setting DATABASE_ENABLED=true).
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
REGISTRATION_MODE=invite
ACCOUNT_REQUIRED=false
ACCOUNT_ACCESS_TOKEN_SECRET=
ACCOUNT_ACCESS_TOKEN_TTL_MINUTES=30
ACCOUNT_REFRESH_TOKEN_TTL_DAYS=30
ACCOUNT_MAGIC_CODE_TTL_MINUTES=15
ACCOUNT_SMTP_ADDR=
ACCOUNT_SMTP_FROM=
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=

# Used only by the internal PostgreSQL container in docker-compose.prod.yml.
# Generate a hexadecimal password, for example: openssl rand -hex 32
POSTGRES_DB=deinscomplete
POSTGRES_USER=deinscomplete
POSTGRES_PASSWORD=
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_VERSION=
AI_FALLBACK_COMPLETION_MODE=chat
AI_FALLBACK_API_MODE=chat
AI_FALLBACK_FIM_FILENAME_CONTEXT_ENABLED=false
AI_MAX_ROUTER_ATTEMPTS=2
AI_ROUTER_TIMEOUT_MS=8000

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01

EVALUATION_CONFIRM_PROVIDER_COST=yes
EVALUATION_BACKEND_URL=https://api.deinscomplete.web.id

ACCOUNT_SMTP_ADDR=in-v3.mailjet.com:587
ACCOUNT_SMTP_FROM=noreply@deinscomplete.web.id
ACCOUNT_SMTP_USERNAME=<MAILJET_API_KEY>
ACCOUNT_SMTP_PASSWORD=<MAILJET_SECRET_KEY>

DATABASE_ENABLED=true
DATABASE_URL=postgres://...

DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MINUTES=30

REGISTRATION_MODE=invite
ACCOUNT_ACCESS_TOKEN_SECRET=<minimal-32-karakter-random>
ACCOUNT_ACCESS_TOKEN_TTL_MINUTES=30
ACCOUNT_REFRESH_TOKEN_TTL_DAYS=30
ACCOUNT_MAGIC_CODE_TTL_MINUTES=15
